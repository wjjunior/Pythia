# Pythia configuration (System Design Appendix A.3).
# Copy to `.env` and adjust. No secrets are committed; leave keys blank to run the
# deterministic stub end-to-end with zero secrets.

# ---- Core infrastructure ----
# Host port 5434 maps to the container's 5432 (avoids colliding with a local Postgres on 5432).
DATABASE_URL=postgresql+psycopg://pythia:pythia@localhost:5434/pythia
# REDIS_URL is optional — only when the worker offloads to Redis (compose `redis` profile).
# REDIS_URL=redis://localhost:6379/0

# ---- Mode & venue gating (System Design §8.6) ----
# MODE is paper-only; real-money execution stays gated until the calibration gate is cleared.
MODE=paper
# The builder runs from Brazil, where Polymarket/Kalshi are geo-restricted. Live venue access
# needs a VPN and is operator-gated. The whole stack runs offline (stub + fixtures) by default,
# so keep this off unless you have deliberately enabled the VPN for a live session.
USE_LIVE_VENUES=false

# ---- LLM / embeddings (optional → stub) ----
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER=
# LLM_MODEL=
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# MODEL_ROUTING=
MODEL_ROUTING_STRATEGY=static
# MAX_PRICE_PER_CALL=
# DISCOVERY_SHORTLIST_SIZE=  # unset = score all open markets; set N = shortlist the top N

# ---- Venues ----
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# KALSHI_API_BASE=
# METACULUS_API_BASE=
# Metaculus gates the community prediction behind approved API access (api-requests@metaculus.com);
# without it question metadata is readable but the aggregated price is withheld. Leave blank to skip.
# METACULUS_API_KEY=
# CROSS_VENUE_SOURCES=kalshi,metaculus,manifold
CRAWL_INTERVAL_SECONDS=300

# ---- Evidence ingest (§2.1) ----
# EVIDENCE_SOURCES=newsapi
# NEWSAPI_KEY=

# ---- Paper bankroll, sizing & risk caps ----
BANKROLL_PAPER=10000
KELLY_MULT=0.25
CAP_PER_TRADE=0.02
CAP_PER_CATEGORY=0.10
CAP_DAILY=0.05
CAP_WEEKLY=0.15
MIN_SOURCE_RELIABILITY=0.5
MIN_CONFIDENCE=0.5
MAX_P_RESOL_SEVERITY=0.5
MAX_CATEGORY_INVALID_RATE=0.15
DIVERGENCE_PENALTY_WEIGHT=1.0

# ---- Cost guards ----
COST_CAP_PER_RUN=1.0
COST_BUDGET_DAILY=10.0

# ---- Growth simulation ----
RUIN_FLOOR=0.5
GROWTH_SIM_PATHS=10000
GROWTH_SIM_HORIZON=365
GROWTH_SIM_SEED=42

# ---- Forecast aggregation & recalibration ----
AGGREGATION_METHOD=median
ENSEMBLE_SIZE=1
# Critic attempts per model before falling back to the next diverse model on unparseable JSON.
CRITIC_MAX_ATTEMPTS=2
RECALIBRATION_METHOD=platt
RECALIBRATION_MIN_N=50
DISPUTE_RISK_LOOKBACK=90

# ---- Calibration gate (§8.5) ----
# A category clears the gate only on measured calibration (delta > margin over >= min_n resolutions,
# EV honest); the invalid-rate cap reuses MAX_CATEGORY_INVALID_RATE. Real-money execution stays
# unimplemented until a category clears.
GATE_MIN_N=50
GATE_BRIER_MARGIN=0.01
GATE_EV_TOLERANCE=0.05

# ---- Post-mortem & improvement loop (§5.5) ----
POSTMORTEM_SURPRISE_THRESHOLD=0.6
POSTMORTEM_MIN_CONFIDENCE=0.6
POSTMORTEM_DRIFT_WINDOW=20
POSTMORTEM_STALE_EVIDENCE_DAYS=30
IMPROVEMENT_VALIDATION_MIN_N=30

# ---- Observability (§3.10, §8.4) ----
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=dev
# LOGFIRE_TOKEN=          # unset -> Logfire is a no-op (zero-secret default)
